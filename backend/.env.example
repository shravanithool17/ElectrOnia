# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Atlas connection string. Use a dedicated database user for this app.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/electronia?retryWrites=true&w=majority

# --- Auth -----------------------------------------------------------------
# At least 32 characters. The app refuses to boot without it. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed the catalogue on boot when the products collection is empty.
SEED_ON_BOOT=true

# --- Email ----------------------------------------------------------------
# With SMTP_USER and SMTP_PASS blank, verification codes are LOGGED TO THE API
# CONSOLE instead of emailed, so local development works offline. Signup still
# functions — you just read the code off the terminal. Check delivery without
# creating an account:
#
#   npm run mail:test -- you@example.com
#
# GMAIL: SMTP_PASS must be a 16-character App Password, NOT your account
# password, which Google rejects outright. Google Account → Security →
# 2-Step Verification (turn on first) → App passwords → generate → paste it
# here with the spaces removed.
SMTP_USER=
SMTP_PASS=

# A transactional provider (Brevo, Resend, SES, Postmark, or Mailtrap for
# staging) gives you a host and port instead. Set SMTP_HOST and these win over
# the Gmail shortcut. Port 465 is implicit TLS; 587 upgrades with STARTTLS.
# Use one of these in production — Gmail rate-limits and is not built for it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
# Only used when SMTP_HOST is blank: the nodemailer service shortcut.
SMTP_SERVICE=gmail

# The From header. Gmail rewrites the address to the authenticated account, so
# there only the display name matters; a real provider honours all of it.
MAIL_FROM=ElectrOnia <no-reply@electronia.local>
MAIL_REPLY_TO=

# --- Links in email -------------------------------------------------------
# Email has no incoming request to infer an origin from, so the storefront URL
# used in email buttons has to be configured. Set it to your deployed frontend.
APP_URL=http://localhost:5173

# --- Payments (Razorpay) --------------------------------------------------
# Dashboard → Settings → API Keys → Generate Test Key. The key id is PUBLIC —
# it is handed to the browser to open Checkout. The key secret is not, and must
# never appear in frontend code or a commit.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# A SEPARATE secret, set when you create the webhook. Using the key secret here
# is the most common webhook mistake — every delivery fails verification.
# Without it the API rejects webhooks outright, because accepting unverifiable
# instructions to mark orders paid is worse than dropping them.
#
# Dashboard → Settings → Webhooks → Add New Webhook
#   URL:    <public API url>/api/v1/payments/razorpay/webhook
#   Events: payment.captured, payment.failed, order.paid
#
# Razorpay cannot reach localhost, so for local testing expose the API with a
# tunnel (ngrok / cloudflared) and use that URL.
RAZORPAY_WEBHOOK_SECRET=

# Check the keys without going through checkout:
#   npm run pay:check
